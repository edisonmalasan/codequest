# Frontend-only public configuration. Copy to frontend/.env.local and replace placeholders.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001
NEXT_PUBLIC_RUNTIME_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_PREVIEW_ORIGIN=http://127.0.0.2:3000

# Optional beta analytics and monitoring. Leave disabled unless the privacy,
# consent, provider, and telemetry gates explicitly authorize collection.
# NEXT_PUBLIC_ANALYTICS_CAPTURE_APPROVED=true
# NEXT_PUBLIC_POSTHOG_PROJECT_KEY=YOUR_POSTHOG_PROJECT_KEY
# NEXT_PUBLIC_POSTHOG_HOST=https://YOUR_POSTHOG_HOST
# NEXT_PUBLIC_MONITORING_CAPTURE_APPROVED=true
# NEXT_PUBLIC_SENTRY_DSN=https://YOUR_PUBLIC_KEY@YOUR_SENTRY_HOST/PROJECT_ID
# NEXT_PUBLIC_CODEQUEST_RELEASE=YOUR_RELEASE_ID
