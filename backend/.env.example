# Backend-only configuration. Copy to backend/.env.local and replace placeholders.
# Use the PostgreSQL connection URI from the Supabase dashboard.
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME
SUPABASE_AUTH_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_AUTH_AUDIENCE=authenticated
SUPABASE_AUTH_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_AUTH_MAX_TOKEN_AGE_SECONDS=3600
CORS_ORIGINS=http://localhost:3000
HOST=127.0.0.1
PORT=3001

# Optional backend request limits. Built-in defaults are shown.
# BODY_LIMIT_BYTES=262144
# RATE_LIMIT_TTL_MS=60000
# RATE_LIMIT_MAX=120

# Optional beta analytics and monitoring. Leave disabled unless the privacy,
# consent, provider, and telemetry gates explicitly authorize collection.
# ANALYTICS_CAPTURE_APPROVED=true
# POSTHOG_PROJECT_KEY=YOUR_POSTHOG_PROJECT_KEY
# POSTHOG_HOST=https://YOUR_POSTHOG_HOST
# MONITORING_CAPTURE_APPROVED=true
# SENTRY_DSN=https://YOUR_PUBLIC_KEY@YOUR_SENTRY_HOST/PROJECT_ID
# CODEQUEST_RELEASE=YOUR_RELEASE_ID
# MONITORING_SLOW_MS=1000
